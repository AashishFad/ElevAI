# ==============================================================================
# ElevAI — Master Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND-ONLY ENVIRONMENT VARIABLES (Set in Render Web Service / server/.env)
# NEVER EXPOSE THESE VARIABLES TO THE FRONTEND BROWSER
# ------------------------------------------------------------------------------

# Server Runtime
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_SECRET="generate-a-strong-random-64-character-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Google Gemini API
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# Supabase Storage & Admin API
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# CORS Allowed Frontend Origin(s)
# In production, set this to your deployed Render static site origin (e.g., https://elevai.onrender.com)
CLIENT_URL="https://your-frontend-domain.onrender.com"

# Upload Limits
MAX_FILE_SIZE_MB=5

# ------------------------------------------------------------------------------
# FRONTEND-SAFE ENVIRONMENT VARIABLES (Set in Render Static Site / client/.env)
# ONLY VARIABLES PREFIXED WITH VITE_ ARE BUNDLED INTO THE CLIENT
# ------------------------------------------------------------------------------

# Express Backend API Base URL
VITE_API_BASE_URL="https://your-backend-domain.onrender.com/api"

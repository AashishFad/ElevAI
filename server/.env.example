# ==============================================================================
# ElevAI Server Environment Configuration (.env.example)
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_SECRET="generate-a-strong-random-64-character-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Google Gemini API
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# Supabase Admin / Storage
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# CORS Allowed Frontend Origin(s)
# Set to the deployed frontend URL (e.g., https://elevai.onrender.com)
CLIENT_URL="https://your-frontend-domain.onrender.com"

# Upload Limits
MAX_FILE_SIZE_MB=5
